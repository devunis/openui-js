# Ollama (default)
API_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=
DEFAULT_MODEL=llama3.2

# OpenAI example
# API_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# DEFAULT_MODEL=gpt-4.1-mini

HOST=127.0.0.1
PORT=8000
DATABASE_PATH=data/openui.db
SESSION_TTL_DAYS=30
COOKIE_SECURE=false
REQUIRE_AUTH=true
ALLOW_REGISTRATION=true
ENABLE_MEMORIES=true
MEMORY_USER_CHAR_LIMIT=2000
MEMORY_CONTEXT_CHAR_LIMIT=2000

# Optional web search (external JSON POST API or SearXNG JSON endpoint)
ENABLE_WEB_SEARCH=false
WEB_SEARCH_PROVIDER=external
WEB_SEARCH_URL=
WEB_SEARCH_API_KEY=
WEB_SEARCH_RESULT_COUNT=5

# Additional OpenAI-compatible providers (keys stay server-side)
PROVIDERS_JSON=[]

# Built-in function tools and optional allowlisted remote MCP tools
ENABLE_TOOLS=true
MCP_SERVERS_JSON=[]
