{
  "name": "openui-js",
  "version": "1.0.0",
  "description": "React and vanilla JavaScript chat UIs with a shared FastAPI backend.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "npm run dev:react",
    "dev:react": "vite --config vite.react.config.js",
    "dev:vanilla": "vite --config vite.vanilla.config.js",
    "build": "npm run build:react && npm run build:vanilla",
    "build:react": "vite build --config vite.react.config.js",
    "build:vanilla": "vite build --config vite.vanilla.config.js",
    "preview:react": "vite preview --config vite.react.config.js",
    "preview:vanilla": "vite preview --config vite.vanilla.config.js",
    "check": "npm run build",
    "backend": "python -m uvicorn backend.main:app --reload --host 127.0.0.1 --port 8000",
    "test": "python -m pytest backend"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^7.1.3"
  },
  "license": "MIT"
}
